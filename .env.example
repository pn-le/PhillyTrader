# Alpaca PAPER trading credentials
# Get these from https://app.alpaca.markets/  ->  Paper account  ->  "Generate / View API Keys"
ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET=your_paper_secret_here

# Keep this true for the paper (simulated) account. Set to false only for live trading.
ALPACA_PAPER=true
